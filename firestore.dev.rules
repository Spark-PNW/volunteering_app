rules_version = '2';

// LOCAL EMULATOR RULES. Wide open on purpose so the fast local loop (`npm run dev:local`)
// never gets in the way. Staging, PR previews and production run
// firestore.restricted.rules instead, so check with `npm run dev:restricted`.
//
// NEVER deploy this to a project holding real user data.
service cloud.firestore {
  match /databases/{database}/documents {
    // Signed-in users can read and write everything (including their own role).
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // Signed-out visitors: browse and view events, and guest signup.
    match /opportunities/{opportunityId} {
      allow read: if true;
    }

    match /signups/{signupId} {
      allow create, update: if request.auth == null
        && request.resource.data.studentId == "guest"
        && request.resource.data.studentEmail is string
        && request.resource.data.studentEmail.size() > 3
        && request.resource.data.opportunityId is string;
    }
  }
}
